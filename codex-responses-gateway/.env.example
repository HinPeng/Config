# API key used only between Codex and this local gateway.
# Put the same value into the Codex provider's OPENAI_API_KEY field in cc-switch.
CODEX_GATEWAY_API_KEY=replace-with-a-long-random-local-key

# These are the upstream values from each cc-switch provider.
# Keep them in .env, never commit .env, and do not put them into routes.json.
WECODING_LUNA_BASE_URL=https://replace-with-luna-upstream.example
WECODING_LUNA_API_KEY=replace-with-wecoding-luna-key
WECODING_PLUS_BASE_URL=https://replace-with-plus-upstream.example
WECODING_PLUS_API_KEY=replace-with-wecoding-plus-key
